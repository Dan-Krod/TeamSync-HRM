@startuml
top to bottom direction
skinparam linetype ortho
skinparam roundcorner 8
skinparam shadowing true
skinparam defaultFontName "Segoe UI"
skinparam nodesep 140
skinparam ranksep 45

skinparam class {
    BorderColor #1C2833
    ArrowColor #2C3E50
    HeaderBackgroundColor #D5D8DC
    BackgroundColor #FFFFFF
    
    BackgroundColor<<Facade>> #FADBD8
    BackgroundColor<<Composite>> #AED6F0
    BackgroundColor<<State>> #A9DFBF
    BackgroundColor<<Strategy>> #F9E79F
    BackgroundColor<<Factory>> #D7BDE2
    BackgroundColor<<Observer>> #A3E4D7
    BackgroundColor<<REST>> #E5E7E9
    BackgroundColor<<Repository>> #EDBB99
    BackgroundColor<<Leaf>> #AED6F0
    BackgroundColor<<Context>> #A9DFBF
}

skinparam package {
    BackgroundColor transparent
    BorderColor #BDC3C7
    FontColor #2C3E50
    FontSize 14
    FontStyle bold
}

package "API & Controllers (Flask Blueprints)" as P_WEB {
    class EmployeeRoutes <<REST>> {
        + get_employees(): JSON
        + get_employee(id: int): JSON
        + create_employee(data: JSON): JSON
        + update_employee(id: int, data: JSON): JSON
        + delete_employee(id: int): JSON
    }
    
    class LeaveRoutes <<REST>> {
        + create_leave(data: JSON): JSON
        + get_leaves(): JSON
        + approve_leave(id: int): JSON
        + reject_leave(id: int): JSON
    }
    
    class PayrollRoutes <<REST>> {
        + calculate_and_save_payroll(emp_id: int): JSON
    }
    
    class ReportRoutes <<REST>> {
        + get_department_reports(): JSON
        + get_leaves_analytics(): JSON
        + export_report(): File
    }

    class DocumentRoutes <<REST>> {
        + generate_document(emp_id: Int): File
    }
}

package "HR & Onboarding Module" as P_FACADE {
    class OnboardingFacade <<Facade>> {
        + {static} onboard_new_employee(data: dict): Employee
    }
}

package "Organization Structure (Domain)" as P_ORG {
    interface IOrganizationUnit <<Composite>> {
        + get_headcount(): int
        + get_budget(): float
    }
    
    class DepartmentComposite <<Composite>> {
        + id: Int
        + name: String
        + manager_id: Int
        - _units: List<IOrganizationUnit>
        + add(unit: IOrganizationUnit): void
        + get_headcount(): int
        + get_budget(): float
        + generate_report(): dict
    }
    
    class EmployeeLeaf <<Leaf>> {
        + employee: Employee
        + get_headcount(): int
        + get_budget(): float
    }
    
    class Employee {
        + id: Int
        + first_name: String
        + last_name: String
        + email: String
        + phone: String
        + position: String
        + salary: Float
        + hire_date: Date
        + role: String
        + password_hash: String
        + set_password(pw: String): void
        + check_password(pw: String): Boolean
    }
    
    IOrganizationUnit <|.. EmployeeLeaf
    IOrganizationUnit <|.. DepartmentComposite
    EmployeeLeaf -down-> Employee : wraps 
    DepartmentComposite "1" *-up-> "0..*" IOrganizationUnit
}

package "Payroll System" as P_PAY {
    class PayrollService <<Strategy>> {
        - strategy: IPayrollStrategy
        + set_strategy(s: IPayrollStrategy): void
        + calculate_salary(emp: Employee): float
    }
    
    interface IPayrollStrategy <<Strategy>> {
        + calculate(emp: Employee): float
    }
    
    class FullTimeStrategy <<Strategy>> {
        + calculate(emp: Employee): float
    }
    
    class HourlyStrategy <<Strategy>> {
        + calculate(emp: Employee): float
    }
    
    PayrollService o-down-> "1" IPayrollStrategy : executes
    IPayrollStrategy <|.. FullTimeStrategy
    IPayrollStrategy <|.. HourlyStrategy
}

package "Leave Management Module" as P_LEAVE {
    class LeaveRequestManager <<Context>> {
        + request: LeaveRequest
        + state: ILeaveState
        - _observers: List<ILeaveObserver>
        - _get_state_object(): ILeaveState
        + attach(observer: ILeaveObserver): void
        + detach(observer: ILeaveObserver): void
        - _notify(event: str): void
        + approve(): void
        + reject(): void
    }
    
    class LeaveRequest {
        + id: int
        + employee_id: int
        + type: str
        + start_date: Date
        + end_date: Date
        + status: str
        + reason: Text
    }
    
    interface ILeaveState <<State>> {
        + process(request: LeaveRequest): void
    }
    
    class PendingState <<State>> {
        + process(request: LeaveRequest): void
    }
    
    class ApprovedState <<State>> {
        + process(request: LeaveRequest): void
    }

    interface ILeaveObserver <<Observer>> {
        + update(leave_request: LeaveRequest, event: str): void
    }

    class EmailNotificationObserver <<Observer>> {
        + update(leave_request: LeaveRequest, event: str): void
    }

    class AuditLogObserver <<Observer>> {
        + update(leave_request: LeaveRequest, event: str): void
    }
    
    LeaveRequestManager -right-> "1" LeaveRequest : manages
    LeaveRequestManager o-down-> "1" ILeaveState : current state
    LeaveRequestManager o-down-> "0..*" ILeaveObserver : notifies
    ILeaveState <|.. PendingState
    ILeaveState <|.. ApprovedState
    ILeaveObserver <|.. EmailNotificationObserver
    ILeaveObserver <|.. AuditLogObserver

    ' Складаємо Observer під State, щоб не розтягувати по ширині
    PendingState -[hidden]down-> ILeaveObserver
    ApprovedState -[hidden]down-> ILeaveObserver
}

package "Document Generation Module" as P_DOC {
    class HRDocumentFactory <<Factory>> {
        + {static} create_document(doc_type: str, emp: Employee): BaseDocument
    }
    
    abstract class BaseDocument <<Factory>> {
        + id: Int
        + employee_id: Int
        + doc_type: String
        + file_path: String
        + employee: Employee
        - _render_pdf(html: str): bytes
        + {abstract} generate_pdf(): tuple
    }
    
    class ContractDocument <<Factory>> {
        + generate_pdf(): tuple
    }
    
    class OrderDocument <<Factory>> {
        + generate_pdf(): tuple
    }
    
    HRDocumentFactory .down.> BaseDocument : creates
    BaseDocument <|-- ContractDocument
    BaseDocument <|-- OrderDocument
}

package "Data Access Layer (Persistence)" as P_DATA {
    interface IEmployeeRepository <<Repository>> {
        + save(emp: Employee): boolean
        + findById(id: Int): Employee
    }
    class SQLEmployeeRepository <<Repository>> {
        - dbSession: SQLAlchemy.Session
        + save(emp: Employee): boolean
        + findById(id: Int): Employee
    }
    
    interface ILeaveRepository <<Repository>> {
        + save(req: LeaveRequest): boolean
        + getByEmployeeId(emp_id: Int): List<LeaveRequest>
    }
    class SQLLeaveRepository <<Repository>> {
        - dbSession: SQLAlchemy.Session
        + save(req: LeaveRequest): boolean
        + getByEmployeeId(emp_id: Int): List<LeaveRequest>
    }
    
    interface IDocumentRepository <<Repository>> {
        + save(doc: BaseDocument): boolean
    }
    class SQLDocumentRepository <<Repository>> {
        - dbSession: SQLAlchemy.Session
        + save(doc: BaseDocument): boolean
    }
    
    IEmployeeRepository <|.. SQLEmployeeRepository
    ILeaveRepository <|.. SQLLeaveRepository
    IDocumentRepository <|.. SQLDocumentRepository
}

P_WEB -[hidden]down-> P_ORG
P_WEB -[hidden]down-> P_FACADE
P_FACADE -[hidden]down-> P_PAY
P_ORG -[hidden]down-> P_LEAVE
P_PAY -[hidden]down-> P_DOC
P_LEAVE -[hidden]down-> P_DATA
P_DOC -[hidden]down-> P_DATA

Employee "1" *-down-> "0..*" BaseDocument : owns 
Employee "1" *-down-> "0..*" LeaveRequest : submits 
PayrollService ..> Employee : calculates for 

EmployeeRoutes -down-> OnboardingFacade : delegates
LeaveRoutes -down-> LeaveRequestManager : manages
PayrollRoutes -down-> PayrollService : triggers
DocumentRoutes -down-> HRDocumentFactory : calls
ReportRoutes -down-> DepartmentComposite : uses
OnboardingFacade -down-> HRDocumentFactory : calls
OnboardingFacade ..> IEmployeeRepository : persists
LeaveRequestManager ..> ILeaveRepository : updates
DocumentRoutes ..> IDocumentRepository : saves

legend bottom right
  |= Колір |= Патерн / Архітектурний компонент |
  |<#FADBD8>| Facade (Єдина точка входу) |
  |<#AED6F0>| Composite (Дерево організації) |
  |<#A9DFBF>| State (Кінцевий автомат станів) |
  |<#F9E79F>| Strategy (Взаємозамінні алгоритми) |
  |<#D7BDE2>| Factory Method (Генерація об'єктів) |
  |<#A3E4D7>| Observer (Сповіщення та аудит) |
  |<#EDBB99>| Repository (SQLAlchemy/БД) |
  |<#E5E7E9>| Flask Blueprints (REST) |
  |<#FFFFFF>| Доменні сутності та моделі БД (SQLAlchemy) |
endlegend
@enduml